# v12.333:此处原为 `# S=` 和 `# SEEDREAM_I=` —— v12.171 补记用的正则**遇到数字就断**,
# 于是所有名字里带数字的变量都被截成半截,等于**从没被记录过**(`S3_*` 塌成 `S`、
# `SEEDREAM_I2I_DISABLE` 塌成 `SEEDREAM_I`、`LTX_MODEL_I2V` 塌成 `LTX_MODEL_I`、
# `KELING_4K_MODEL` 塌成 `KELING_`)。现按代码里的真名补全。
# ── 对象存储(STORAGE_DRIVER=s3 时生效;缺任一项则回落本地磁盘)──
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=          # 默认 us-east-1
# S3_PUBLIC_BASE_URL= # CDN/自定义域;留空则用 endpoint 拼公开地址
# 置 1 关掉 Seedream 的图生图(只留文生图)
# SEEDREAM_I2I_DISABLE=
# SENDGRID_API_KEY=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
# SERIES_CONCURRENCY=
# STORAGE_DRIVER=
# SUBTITLE_FONT_FILE=
# SYNCSO_API_KEY=
# SYNCSO_BASE_URL=
# TTS_PROVIDERS_DIR=
# ── 逐镜画质门禁的视觉兜底(lib/shot-quality-gate.ts)──
# 显式指定一档 VLM;两者都填才生效,否则按 OpenRouter → MiniMax 的顺序自动入链
# VISION_FALLBACK_BASE_URL=
# VISION_FALLBACK_API_KEY=
# VISION_FALLBACK_MODEL=   # 默认 abab7-chat-preview;只设本项 = 「兜底就用这个模型」
# OPENROUTER_VISION_MODEL= # 默认 qwen/qwen3-vl-235b-a22b-instruct
# ── 受签名保护的文件下发(lib/serve-file-sign.ts)──
# 缺省复用 JWT_SECRET(生产必设);只有想让文件签名与登录令牌用不同密钥时才单独设
# SERVE_FILE_SECRET=
# ── ModelScope 镜像同步(scripts/modelscope-sync.mjs,v12.340)──
# `npm run ms:sync` 用它把代码镜像与模型卡推到 ModelScope。**只从环境变量读、不写盘**,
# 也不要跑 `modelscope login`(那会把令牌存进 ~/.modelscope/credentials)。
# 用法:MODELSCOPE_API_TOKEN=... npm run ms:sync
MODELSCOPE_API_TOKEN=

# ── e2e ──
# playwright 的目标地址,默认 http://localhost:3000
# E2E_BASE_URL=
# ── star 曲线自采(scripts/gen-star-history.mjs,v12.334)──
# GitHub 2026-06-30 起把 stargazers 接口收窄为 admin/collaborator 可访问,第三方 star 曲线
# 服务全部失效;本仓改为自采。**本机无需配置** —— 脚本会自动用 `gh auth token`;
# 在 Actions 里由 workflow 注入 secrets.GITHUB_TOKEN。仅当你想手动指定时才设:
# GITHUB_TOKEN=
# GH_TOKEN=
# VECTORENGINE_API_KEY=
# VECTORENGINE_BASE_URL=
# VE_TTS_MODEL=
# VIDEO_BAKED_DROP=
# VIDEO_PROVIDERS_DIR=
# VIDEO_TEXT_SCREEN_DISABLE=
# VITEST=
# XAI_API_KEY=
# YJS_WS_URL=

