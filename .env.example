# ============================================================================
# Wind Comic — Environment Configuration
# ============================================================================
# Copy this file to `.env.local` and fill in your provider keys.
# Wind Comic is provider-agnostic — every key below has a sensible fallback,
# and you only need to fill in keys for the providers you actually use.
#
# Minimum viable config (cheapest, English/Chinese both work):
#   1) OPENAI_API_KEY           — for script generation (any OpenAI-compatible)
#   2) MINIMAX_API_KEY          — for image + video + TTS (Chinese-friendly)
#
# Recommended config (best quality, cinematic output):
#   1) OPENAI_API_KEY           — Claude/GPT-4 via vectorengine or direct
#   2) MJ_API_KEY               — Midjourney via vectorengine for storyboards
#   3) MINIMAX_API_KEY          — for video + TTS
#   4) QINGYUNTOP_API_KEY       — for Veo-3 / Seedance fallback video(Sora-2 已退役)
# ============================================================================


# ─── 1. LLM (Script + Director + Polish) ───────────────────────────────────
# Any OpenAI-compatible endpoint. Default points to OpenAI;
# override OPENAI_BASE_URL to use proxies (vectorengine.ai, openrouter, etc.)
# OPENAI_CREATIVE_MODEL is used for screenwriting/critique (higher quality);
# OPENAI_MODEL is used for routine planning (faster/cheaper).
OPENAI_API_KEY=your_openai_or_proxy_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_CREATIVE_MODEL=claude-sonnet-4-20250514
# v12.2.2 资产向量化(全局资产记忆库 v2):文本嵌入,用于跨集/跨项目找相似角色/资产。
# 缺省走 OPENAI_BASE_URL;无 key → embedding 列留空,退回精确名+visual_anchors 文本匹配(诚实降级)。
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_EMBED_BASE_URL=   # 仅当嵌入端点与对话不同源时设置

# ─── 2. Image generation ───────────────────────────────────────────────────
# Midjourney via aggregator (best quality for storyboards + character refs)
# Set MJ_BASE_URL to any /mj/submit/imagine compatible aggregator.
MJ_API_KEY=
MJ_BASE_URL=https://api.vectorengine.ai

# Banana.dev (legacy alias for MJ_API_KEY — still read for backward compat)
BANANA_API_KEY=
BANANA_MODEL_KEY=

# ─── 2b. 可选图像 provider(issue #11)—— 走 plugin registry,不配就完全不参与 ────
# 二者都通过 lib/image-providers/ 注册,available() 按 env 门控;注册进来的 provider
# 先于内置引擎链(MJ/Minimax/Kontext)跑,失败自动 fallback 回内置,零侵入。

# GPT Image(OpenAI gpt-image-1)—— 复用上面的 OPENAI_API_KEY / OPENAI_BASE_URL,无需额外申请。
# 默认**关闭**:很多 OPENAI_BASE_URL 指向只做文本的聚合网关,贸然打图像请求会白白 404 拖慢链路,
# 所以要显式开。注意它当前只做文生图(OpenAI 的 i2i 走 /images/edits multipart,形态不同),
# 因此有参考图的镜头会自动跳过它、交给支持 i2i 的档 —— 不会静默丢掉参考图。
OPENAI_IMAGE_ENABLED=
OPENAI_IMAGE_MODEL=gpt-image-1
# 图像端点与文本不同源时单独指定(留空则用 OPENAI_BASE_URL)
OPENAI_IMAGE_BASE_URL=

# Nano Banana(Google Gemini Image)—— 填了 key 即启用。原生支持图生图,
# 参考图直接接进项目既有的角色一致性契约(cref/sref/referenceImages,最多 3 张)。
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# 若这把 key 只想给文本 LLM 用、不想让它接管图像链,设 0 明确关掉(v12.239)
GEMINI_IMAGE_ENABLED=

# v12.239:部署在受信反向代理之后才置 1 —— 否则限流一律不采信 X-Forwarded-For
# (那个头攻击者可控:换 IP 能绕过登录爆破限流,填别人 IP 能打满其限流桶)
TRUST_PROXY_HEADERS=
# v12.239:Yjs 协作 WebSocket。默认只绑回环;要跨机必须显式设 WS_HOST,
# 且此时强制校验从 JWT_SECRET/WS_SHARED_SECRET 派生的共享 token
WS_HOST=
WS_SHARED_SECRET=

# ─── 3. Video generation ───────────────────────────────────────────────────
# Minimax (recommended primary — cheap, fast, Chinese voice support)
# Models: T2V=MiniMax-Hailuo-2.3 / I2V=I2V-01 / TTS=speech-2.8-hd / Music=music-2.6
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com

# v2.12 兜底:Hailuo-2.3-Fast (768P) 是 Minimax 的低质快速版,日额度独立于标准 Hailuo-2.3。
# orchestrator Pass-B 链路:Veo-T2V → Hailuo-2.3 → Hailuo-Fast → Kling → Ken Burns 静帧。
# 标准 Hailuo 用满后,先用同一家的 Fast(成本/响应/失败率更可控),再换 Kling,
# 真视频全失败才掉到 Ken Burns animatic。模型名可改:
MINIMAX_FAST_VIDEO_MODEL=MiniMax-Hailuo-2.3-Fast

# v12.9.0 角色一致性调校(S2V-01 主体参考):
# MINIMAX_S2V_MAX_SUBJECTS:S2V-01 官方「尚未为多主体优化」,默认只锁 1 个主角(锁好一个 > 两个都飘);
#   多角色同框想试多主体锁定可设 2(结果不稳,官方不承诺)。
# MINIMAX_PROMPT_OPTIMIZER:置 1 才开 prompt_optimizer。默认关 —— 开了会改写 prompt 把「服装/外观
#   锚点句」改掉 → 跨镜漂移(头号一致性杀手)。结构化 prompt 必须关。
MINIMAX_S2V_MAX_SUBJECTS=1
MINIMAX_PROMPT_OPTIMIZER=0

# v2.12 Sprint C.4: TTS 默认模型 — 与 minimax.service.ts 的 voiceover 模型对齐。
# 默认 speech-2.8-hd(质量最佳);旧版可填 speech-02 兜底。
MINIMAX_TTS_MODEL=speech-2.8-hd

# Vidu (alternative T2V)
VIDU_API_KEY=
VIDU_BASE_URL=https://api.vidu.ai

# Kling (alternative T2V/I2V)
KELING_API_KEY=
KELING_BASE_URL=https://api.klingai.com

# Veo(及后继)via qingyuntop — Sora-2 API 于 2026-09-24 停服,已从推荐链摘除
# Format: 'unified' uses POST /v1/video/create + GET /v1/video/query
#         'openai'  uses POST /v1/videos       + GET /v1/videos/<id>
VEO_API_KEY=
VEO_BASE_URL=https://api.qingyuntop.top
VEO_MODEL=veo3.1  # 勿配 sora 系:Sora-2 API 2026-09-24 退役
VEO_API_FORMAT=openai
VEO_FALLBACK_MODELS=veo3.1-fast,veo3-fast

# qingyuntop unified gateway (shared key, used as fallback for video + image)
QINGYUNTOP_API_KEY=
QINGYUNTOP_BASE_URL=https://api.qingyuntop.top

# ─── 4. Advanced consistency engines (optional) ────────────────────────────
# fal.ai for FLUX Kontext (state-of-the-art reference-image consistency)
FAL_KEY=

# Local ComfyUI (zero per-image cost, requires self-hosted node)
COMFYUI_URL=http://localhost:8188
COMFYUI_ENABLED=false

# ─── 6. App secrets ────────────────────────────────────────────────────────
# ⚠️⚠️ 危险默认值:下面这行 change_me_... 是**公开占位串**,生产必须改!⚠️⚠️
# JWT 签名密钥 —— 必设(生产 NODE_ENV=production 未设会 fail-fast 拒绝启动)。
# v12.219 起:生产环境若 JWT_SECRET 仍等于本占位值(或其它已知弱默认),同样 **fail-fast 拒启动** ——
#   拷了模板忘改 = 用公开密钥签发令牌 = 任何人可伪造任意用户(含 admin)。别侥幸。
# 未设且非生产 → 进程级随机密钥(重启失效;仓库内无任何可用兜底密钥)。
# 生成: openssl rand -hex 32   (或 openssl rand -base64 32)
# e2e 本地跑:server 与测试进程须同一值,例如
#   JWT_SECRET=e2e-fixture-secret-not-for-prod MOCK_ENGINES=1 PIPELINE_QUEUE=1 npm run dev
JWT_SECRET=change_me_to_a_random_32_char_string

# ─── 6.5. Stripe (Sprint C.2 — 4-tier subscription, optional) ──────────────
# 公网部署时填这一组,Wind Comic 本地 dev 不填等同于免费版无支付链路。
# Test 模式 (sk_test_) 跑通即可 — 支付不会真扣款。
STRIPE_SECRET_KEY=sk_test_xxx_or_sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 在 Stripe Dashboard 创建 4 个 Recurring Price (creator/pro/enterprise),把 price ID 填进来
STRIPE_PRICE_ID_CREATOR=price_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx
# 给前端 billing 页"打开 Customer Portal"按钮用 (Stripe → Settings → Billing → Customer Portal)
NEXT_PUBLIC_STRIPE_PORTAL_LINK=
# 跳回域名(success_url / cancel_url 用),与你部署的域一致
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 6.6. 发布上传适配器 + 定时发布 (v12.3.3 阶段二十二,可选) ─────────────
# BYO 真上传:只 YouTube 有公开发布 API。填了 token → 发布面板「真上传到 YouTube」可用;
# 不填 → 诚实降级为「导出包 + 手动上传指引」(国内平台抖音/快手/视频号/小红书/B站 同此降级,
# 无公开发布 API)。OAuth 授权需你自己做(我不代填),拿到 access token 填这里:
#   1) Google Cloud 建 OAuth 凭据,授权 scope https://www.googleapis.com/auth/youtube.upload
#   2) OAuth Playground / 自有流程换 access token(过期需自行刷新)
YOUTUBE_ACCESS_TOKEN=
# 定时发布 worker 触发端点 /api/cron/run-scheduled-publishes 的鉴权密钥。
# 生产必设(未设则该端点 503 拒跑);本地不设则放行便于手动触发。生成:openssl rand -hex 16
CRON_SECRET=

# ─── 7. Telemetry (optional) ───────────────────────────────────────────────
# Sentry DSN for error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# ⚠️ 危险开关:计费 gate 总开关。置 1 = 关闭所有计费 gate(上线前/本地测试,免费档也能用全部功能);
# 真上线删此行或置 0 即恢复分档计费(导出分辨率 / 视频时长 / Pro 润色 / 发布 等)。
# v12.219 起:**生产环境(NODE_ENV=production)强制忽略此开关** —— 即使误留 =1,付费墙照常生效并打警告日志。
#   仅 dev/test 生效,故本行留在生产 env 里最多是噪音,不再是「免费墙全开」事故。
# PLAN_GATE_DISABLED=0

