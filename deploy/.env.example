# deploy/.env.example — 配合 deploy/docker-compose.yml 使用:cp .env.example .env 后填写。
# 这个文件里不该出现任何真实密钥;.env 只放在你自己的 NAS / 服务器上,不要提交到任何仓库。

# ── 必填 ─────────────────────────────────────────────────────────────
# 会话签名密钥。生成:openssl rand -hex 32
# 留空、或用 .env.example / 教程里的占位串 → 登录页提示「服务端没配置 JWT_SECRET」(接口 503),/api/health 返回 503。
JWT_SECRET=

# 首个账号 demo@qfmanju.ai 的密码。
# 不填的话首次启动随机生成、只在 docker logs 里打印一次;之后补填再重启会自动改成这个值。
DEMO_PASSWORD=

# 任务队列:浏览器关了任务照跑,容器重启后未完成的任务自动续跑
PIPELINE_QUEUE=1

# ── 注册(可选)────────────────────────────────────────────────────────
# 默认注册要邀请码。只有在纯内网、信任每一个能打开这个地址的人时才改成 false。
# BETA_INVITE_REQUIRED=false

# ── 会话 Cookie(可选)──────────────────────────────────────────────
# 默认 auto:http://局域网IP:3100 直连可以登录和创作,经 HTTPS 反代访问时自动加 Secure。
# 只走 HTTPS 的公网部署可以设 true 钉死;详见 docs/DEPLOYMENT.md §12。
# COOKIE_SECURE=auto

# ── 引擎 key(至少配一个才是真生成)──────────────────────────────────
# 一个都不配也能起来,但只能跑演示模式(下面 MOCK_ENGINES=1);各引擎说明见 README「Optional engines」。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# MINIMAX_API_KEY=

# ── 零 key 演示(可选)──────────────────────────────────────────────
# 确定性假引擎(SVG 分镜 / 纯色短片 / 正弦音),只展示流水线,不代表真实生成质量。
# 在 NAS 上跑演示时,APP_URL 要写成浏览器实际访问的地址 —— 演示素材的链接按它拼,
# 写成 localhost 的话,从别的电脑打开会看不到分镜图。
# MOCK_ENGINES=1
# APP_URL=http://192.168.1.10:3100
